{
  "version": "1.2",
  "media": {
    "default_library": "repo_media",
    "libraries": [
      {
        "key": "repo_media",
        "label": "Repository media",
        "references": {
          "write": {
            "mode": "root_relative",
            "base_path": "/"
          },
          "allow_default_library_fallback": true
        },
        "limits": {
          "max_file_size_mb": 10
        },
        "driver": "git",
        "storage": {
          "root_path": "static"
        }
      }
    ]
  },
  "ssg_framework": "hugo",
  "frontmatter_format": "yaml",
  "publishing_mode": "editorial_workflow",
  "collections": [
    {
      "name": "blog",
      "git_path": "/content/blog/",
      "file_extension": ".md",
      "filename_pattern": "",
      "label": "Blog",
      "collection_type": "grouped",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title",
          "required": false
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description",
          "required": false
        },
        {
          "name": "date",
          "type": "datetime",
          "label": "Date",
          "required": false,
          "withTime": true
        },
        {
          "name": "lastmod",
          "type": "datetime",
          "label": "Lastmod",
          "required": false,
          "withTime": true
        },
        {
          "name": "draft",
          "type": "boolean",
          "label": "Draft",
          "required": false,
          "default": false
        },
        {
          "name": "tags",
          "type": "multiselect",
          "label": "Tags",
          "required": false,
          "options": [
            "http",
            "troubleshooting",
            "web development"
          ],
          "allowCustom": true,
          "color": "blue"
        },
        {
          "name": "og_image",
          "type": "image",
          "label": "Og image",
          "required": false
        },
        {
          "name": "schemahowto",
          "type": "richtext",
          "label": "Schemahowto",
          "required": false
        },
        {
          "name": "outputs",
          "type": "multiselect",
          "label": "Outputs",
          "required": false,
          "options": [
            "HTML",
            "AMP"
          ],
          "allowCustom": true,
          "color": "blue"
        }
      ]
    },
    {
      "name": "quickstart",
      "git_path": "/content/quickstart/",
      "file_extension": ".md",
      "filename_pattern": "",
      "label": "Quickstart",
      "collection_type": "flat",
      "frontmatter_schema": []
    },
    {
      "name": "docs",
      "git_path": "/content/docs/",
      "file_extension": ".md",
      "filename_pattern": "",
      "label": "Docs",
      "collection_type": "grouped",
      "frontmatter_schema": []
    },
    {
      "name": "know_your_port",
      "git_path": "/content/know_your_port/",
      "file_extension": ".md",
      "filename_pattern": "",
      "label": "Know your port",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title",
          "required": false
        },
        {
          "name": "date",
          "type": "datetime",
          "label": "Date",
          "required": false
