{
  "version": "1.4",
  "media": {
    "default_library": "repo_media",
    "libraries": [
      {
        "key": "repo_media",
        "label": "Repository media",
        "references": {
          "write": {
            "mode": "root_relative",
            "base_path": "/"
          },
          "allow_default_library_fallback": true
        },
        "limits": {
          "max_file_size_mb": 10
        },
        "driver": "git",
        "storage": {
          "root_path": "static"
        }
      }
    ]
  },
  "ssg_framework": "hugo",
  "frontmatter_format": "yaml",
  "publishing_mode": "editorial_workflow",
  "collections": [
    "blog",
    "quickstart",
    "docs",
    "know_your_port",
    "compare",
    "aidocs",
    "about",
    "app",
    "cli",
    "contact_us",
    "help",
    "ingress_for_dev_test_environments",
    "privacy_policy",
    "terms_of_service",
    "tools",
    "verificationlinkstmp7879"
  ]
}
