{
  "label": "Privacy policy",
  "git_path": "/content/privacy_policy/",
  "file_extension": ".md",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "title",
      "type": "title",
      "label": "Title",
      "required": false
    },
    {
      "name": "date",
      "type": "datetime",
      "label": "Date",
      "required": false,
      "withTime": true
    },
    {
      "name": "draft",
      "type": "boolean",
      "label": "Draft",
      "required": false,
      "default": false
    }
  ]
}
