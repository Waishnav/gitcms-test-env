{
  // `Callout` in shared/Docs/mdx.tsx: `default` and `info` look the same,
  // `tip` is green. `Icon` takes a component, so it stays as written.
  "label": "Callout",
  "dialect": "mdx-jsx",
  "childrenRegion": { "region": "body" },
  "role": {
    "kind": "callout",
    "variantProp": "variant",
    "variants": { "default": "info", "info": "info", "warning": "warning", "tip": "success" }
  },
  "props": [
    { "name": "variant", "label": "Type", "type": "select", "options": ["default", "info", "warning", "tip"] },
    { "name": "skipSearchCrawler", "label": "Hide from search", "type": "boolean" }
  ],
  "import": { "from": "src/shared/Docs/mdx", "name": "Callout" }
}
