{
  // Code blocks shown as tabs: `CodeGroup` in shared/Docs/Code.tsx. Its
  // children are fenced code blocks; each one's title is in its fence.
  "label": "Code group",
  "dialect": "mdx-jsx",
  "childrenRegion": { "region": "code", "label": "Code", "placeholder": "Code blocks, one per tab" },
  "props": [
    { "name": "title", "label": "Title", "type": "text" },
    { "name": "filename", "label": "File name", "type": "text" },
    { "name": "forceTabs", "label": "Always show tabs", "type": "boolean" }
  ],
  "import": { "from": "src/shared/Docs/Code", "name": "CodeGroup" }
}
