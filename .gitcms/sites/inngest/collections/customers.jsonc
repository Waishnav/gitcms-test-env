{
  "label": "Customers",
  "git_path": "/content/customers/",
  "file_extension": ".mdx",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "title",
      "type": "title",
      "label": "Title",
      "required": false
    },
    {
      "name": "companyName",
      "type": "text",
      "label": "Company Name",
      "required": false
    },
    {
      "name": "logo",
      "type": "image",
      "label": "Logo",
      "required": false
    },
    {
      "name": "companyIndustry",
      "type": "text",
      "label": "Company Industry",
      "required": false
    },
    {
      "name": "companyUseCase",
      "type": "richtext",
      "label": "Company Use Case",
      "required": false
    },
    {
      "name": "quote",
      "type": "object",
      "label": "Quote",
      "required": false
    },
    {
      "name": "companyURL",
      "type": "url",
      "label": "Company URL",
      "required": false
    },
    {
      "name": "companyDescription",
      "type": "text",
      "label": "Company Description",
      "required": false
    },
    {
      "name": "ogImage",
      "type": "image",
      "label": "Og Image",
      "required": false
    }
  ]
}
