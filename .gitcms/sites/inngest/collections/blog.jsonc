{
  "label": "Blog",
  "git_path": "/content/blog/",
  "file_extension": ".mdx",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "heading",
      "type": "title",
      "label": "Heading",
      "required": false
    },
    {
      "name": "tags",
      "type": "multiselect",
      "label": "Tags",
      "required": false,
      "options": [
        "Queues & Flow Control",
        "Workflows & Orchestration",
        "Tutorials & Guides",
        "Engineering"
      ],
      "allowCustom": true,
      "color": "blue"
    },
    {
      "name": "focus",
      "type": "boolean",
      "label": "Focus",
      "required": false,
      "default": false
    },
    {
      "name": "subtitle",
      "type": "text",
      "label": "Subtitle",
      "required": false
    },
    {
      "name": "image",
      "type": "image",
      "label": "Image",
      "required": false
    },
    {
      "name": "date",
      "type": "datetime",
      "label": "Date",
      "required": false
    }
  ]
}
