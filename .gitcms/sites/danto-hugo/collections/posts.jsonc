{
  "label": "Posts",
  "git_path": "/content/posts/",
  "file_extension": ".md",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "title",
      "type": "title",
      "label": "Title",
      "required": false
    },
    {
      "name": "description",
      "type": "richtext",
      "label": "Description",
      "required": false
    },
    {
      "name": "date",
      "type": "datetime",
      "label": "Date",
      "required": false,
      "withTime": true
    },
    {
      "name": "authors",
      "type": "multiselect",
      "label": "Authors",
      "required": false,
      "options": [
        "kaiya"
      ],
      "allowCustom": true,
      "color": "blue"
    },
    {
      "name": "image",
      "type": "image",
      "label": "Image",
      "required": false
    },
    {
      "name": "tags",
      "type": "multiselect",
      "label": "Tags",
      "required": false,
      "options": [
        "people"
      ],
      "allowCustom": true,
      "color": "blue"
    },
    {
      "name": "featured",
      "type": "boolean",
      "label": "Featured",
      "required": false,
      "default": true
    }
  ]
}
