{
  "label": "Posts",
  "git_path": "/content/posts/",
  "file_extension": ".md",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "title",
      "type": "title",
      "label": "Title",
      "required": false
    },
    {
      "name": "description",
      "type": "richtext",
      "label": "Description",
      "required": false
    },
    {
      "name": "date",
      "type": "datetime",
      "label": "Date",
      "required": false,
      "withTime": true
    },
    {
      "name": "authors",
      "type": "multiselect",
      "label": "Authors",
      "required": false,
      "options": [
        "kaiya"
      ],
      "allowCustom": true,
      "color": "blue"
    },
    {
      "name": "image",
      "type": "image",
      "label": "Image",
      "required": false
    },
    {
      "name": "tags",
      "type": "multiselect",
      "label": "Tags",
      "required": false,
      "options": [
        "people"
      ],
      "allowCustom": true,
      "color": "blue"
    },
    {
      "name": "featured",
      "type": "boolean",
      "label": "Featured",
      "required": false,
      "default": true
    },
    {
      "name": "mood",
      "type": "select",
      "label": "Mood",
      "description": "",
      "required": false,
      "options": [
        "calm",
        "cheerful"
      ],
      "allowCustom": false
    },
    {
      "name": "topics",
      "type": "multiselect",
      "label": "Topics",
      "required": false,
      "options": [
        "cars",
        "health"
      ]
    },
    {
      "name": "strict",
      "type": "select",
      "label": "Strict",
      "required": false,
      "options": [
        "draft",
        "final"
      ],
      "allowCustom": false
    },
    {
      "name": "strictmany",
      "type": "multiselect",
      "label": "Strictmany",
      "required": false,
      "options": [
        "north",
        "south"
      ],
      "allowCustom": false
    },
    {
      "name": "nothing",
      "type": "select",
      "label": "Nothing",
      "required": false,
      "allowCustom": false
    },
    {
      "name": "nothingmany",
      "type": "multiselect",
      "label": "Nothingmany",
      "required": false,
      "allowCustom": false
    }
  ]
}
