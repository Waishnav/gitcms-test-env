{
  "version": "1.4",
  "media": {
    "default_library": "repo_media",
    "libraries": [
      {
        "key": "repo_media",
        "label": "Repository media",
        "references": {
          "write": {
            "mode": "root_relative",
            "base_path": "/"
          },
          "allow_default_library_fallback": true
        },
        "limits": {
          "max_file_size_mb": 10
        },
        "driver": "git",
        "storage": {
          "root_path": "static"
        }
      }
    ]
  },
  "ssg_framework": "hugo",
  "frontmatter_format": "yaml",
  "sitemap_url": "http://gohugo.io/sitemap.xml",
  "publishing_mode": "editorial_workflow",
  "i18n": {
    "enabled": false,
    "locales": [
      "en"
    ],
    "default_locale": "en"
  },
  "collections": [
    "posts",
    "authors"
  ]
}
