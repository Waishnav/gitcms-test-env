{
  "label": "Articles",
  "git_path": "/_articles/",
  "file_extension": ".md",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "title",
      "type": "title",
      "label": "Title",
      "required": false
    },
    {
      "name": "layout",
      "type": "text",
      "label": "Layout",
      "required": false
    },
    {
      "name": "description",
      "type": "richtext",
      "label": "Description",
      "required": false
    },
    {
      "name": "permalink",
      "type": "text",
      "label": "Permalink",
      "required": false
    }
  ]
}
