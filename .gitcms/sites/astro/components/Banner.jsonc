{
  // A highlighted band: its title in place, a tone, and a body.
  // <Banner title="…" tone="info">Body…</Banner>
  "label": "Banner",
  "dialect": "mdx-jsx",
  "attributeRegions": [{ "attribute": "title", "region": "title", "placeholder": "Banner title" }],
  "childrenRegion": { "region": "body", "placeholder": "What the banner says" },
  "props": [
    { "name": "tone", "label": "Tone", "type": "select", "options": ["info", "success", "warning"] }
  ]
}
