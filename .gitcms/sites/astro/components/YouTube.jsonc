{
  "dialect": "mdx-jsx",
  "import": {
    "from": "@astro-community/astro-embed-youtube",
    "name": "YouTube"
  },
  "children": {
    "kind": "none"
  },
  "props": [
    {
      "name": "id",
      "label": "ID",
      "required": true,
      "type": "text"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text"
    },
    {
      "name": "params",
      "label": "Params",
      "type": "text"
    },
    {
      "name": "posterQuality",
      "label": "Poster Quality",
      "type": "select",
      "options": [
        "high"
      ]
    },
    {
      "name": "class",
      "label": "Class",
      "type": "text"
    }
  ]
}
