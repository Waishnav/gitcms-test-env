{
  "version": "1.2",
  "media": {
    "default_library": "repo_media",
    "libraries": [
      {
        "key": "repo_media",
        "label": "Repository media",
        "references": {
          "write": {
            "mode": "root_relative",
            "base_path": "/"
          },
          "allow_default_library_fallback": true
        },
        "limits": {
          "max_file_size_mb": 10
        },
        "driver": "git",
        "storage": {
          "root_path": "public"
        }
      }
    ]
  },
  "ssg_framework": "astro",
  "frontmatter_format": "yaml",
  "publishing_mode": "editorial_workflow",
  "collections": [
    {
      "name": "blog",
      "git_path": "/src/content/blog/",
      "file_extension": ".mdx",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title",
          "required": false
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description",
          "required": false
        },
        {
          "name": "publishDate",
          "type": "datetime",
          "label": "Publish Date",
          "required": false
        },
        {
          "name": "authors",
          "type": "multiselect",
          "label": "Authors",
          "required": false,
          "options": [
            "fred"
          ],
          "allowCustom": true,
          "color": "blue"
        },
        {
          "name": "lang",
          "type": "text",
          "label": "Lang",
          "required": false
        },
        {
          "name": "socialImage",
          "type": "image",
          "label": "Social Image",
          "required": false
        }
      ]
    },
    {
      "name": "caseStudies",
      "git_path": "/src/content/caseStudies/",
      "file_extension": ".mdx",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title",
          "required": false
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description",
          "required": false
        },
        {
          "name": "seo",
          "type": "json",
          "label": "Seo",
          "required": false
        },
        {
          "name": "coverGradientFrom",
          "type": "text",
          "label": "Cover Gradient From",
          "required": false
        },
        {
          "name": "coverGradientTo",
          "type": "text",
          "label": "Cover Gradient To",
          "required": false
        },
        {
          "name": "publishDate",
          "type": "datetime",
          "label": "Publish Date",
          "required": false
        },
        {
          "name": "authors",
          "type": "multiselect",
          "label": "Authors",
          "required": false,
          "options": [
            "astro-team"
          ],
          "allowCustom": true,
          "color": "blue"
        },
        {
          "name": "lang",
          "type": "text",
          "label": "Lang",
          "required": false
        },
        {
          "name": "socialImage",
          "type": "image",
          "label": "Social Image",
          "required": false
        },
        {
          "name": "coverImage",
          "type": "image",
          "label": "Cover Image",
          "required": false
        },
        {
          "name": "headerImage",
          "type": "image",
          "label": "Header Image",
          "required": false
        }
      ]
    },
    {
      "name": "pages",
      "git_path": "/src/content/pages/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "grouped",
      "frontmatter_schema": [
        {
          "name": "seo",
          "type": "json",
          "label": "Seo",
          "required": false
        },
        {
          "name": "pageLayout",
          "type": "text",
          "label": "Page Layout",
          "required": false
        },
        {
          "name": "image",
          "type": "image",
          "label": "Image",
          "required": false
        }
      ]
    },
    {
      "name": "agencies",
      "git_path": "/src/content/agencies/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "name",
          "type": "title",
          "label": "Name",
          "required": false
        },
        {
          "name": "location",
          "type": "text",
          "label": "Location",
          "required": false
        },
        {
          "name": "url",
          "type": "url",
          "label": "Url",
          "required": false
        },
        {
          "name": "image",
          "type": "image",
          "label": "Image",
          "required": false
        },
        {
          "name": "imageAlt",
          "type": "text",
          "label": "Image Alt",
          "required": false
        },
        {
          "name": "contactLink",
          "type": "url",
          "label": "Contact Link",
          "required": false
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description",
          "required": false
        }
      ]
    },
    {
      "name": "quotes",
      "git_path": "/src/content/quotes/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "author",
          "type": "json",
          "label": "Author",
          "required": false
        },
        {
          "name": "url",
          "type": "url",
          "label": "Url",
          "required": false
        },
        {
          "name": "published",
          "type": "datetime",
          "label": "Published",
          "required": false
        }
      ]
    },
    {
      "name": "careers",
      "git_path": "/src/content/careers/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title",
          "required": false
        },
        {
          "name": "published",
          "type": "datetime",
          "label": "Published",
          "required": false
        },
        {
          "name": "location",
          "type": "text",
          "label": "Location",
          "required": false
        },
        {
          "name": "team",
          "type": "text",
          "label": "Team",
          "required": false
        },
        {
          "name": "type",
          "type": "text",
          "label": "Type",
          "required": false
        }
      ]
    },
    {
      "name": "partials",
      "git_path": "/src/content/partials/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": []
    }
  ]
}
