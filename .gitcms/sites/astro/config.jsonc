{
  "version": "1.4",
  "media": {
    "default_library": "repo_media",
    "libraries": [
      {
        "key": "repo_media",
        "label": "Repository media",
        "references": {
          "write": {
            "mode": "root_relative",
            "base_path": "/"
          },
          "allow_default_library_fallback": true
        },
        "limits": {
          "max_file_size_mb": 10
        },
        "driver": "git",
        "storage": {
          "root_path": "public"
        }
      }
    ]
  },
  "ssg_framework": "astro",
  "frontmatter_format": "yaml",
  "publishing_mode": "editorial_workflow",
  "i18n": {
    "enabled": false,
    "locales": [
      "en"
    ],
    "default_locale": "en"
  },
  "collections": [
    "blog",
    "casestudies",
    "pages",
    "agencies",
    "quotes",
    "careers",
    "partials"
  ],
  "singletons": [
    "authors-authors",
    "last-modified",
    "stats"
  ]
}
