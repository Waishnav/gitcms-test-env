---
// GitCMS QA fixture: an embedded YouTube video.
interface Props { id: string; title?: string; start?: number }
const { id, title = 'YouTube video', start } = Astro.props
---
<iframe src={`https://www.youtube-nocookie.com/embed/${id}${start ? `?start=${start}` : ''}`} title={title} allowfullscreen loading="lazy"></iframe>
